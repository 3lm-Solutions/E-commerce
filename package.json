{
  "name": "ecommerce",
  "version": "1.0.0",
  "description": "Plateforme e-commerce intelligente",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "db:test-connection": "node scripts/test-db-connection.js",
    "db:validate-config": "node scripts/validate-config.js",
    "db:check-tables": "node scripts/check-tables.js",
    "catalog:test": "node scripts/test-catalog-api.js",
    "catalog:seed": "node scripts/create-catalog-data.js",
    "users:create": "node scripts/create-test-users.js",
    "admin:test": "node scripts/test-admin-endpoints.js",
    "migration:generate": "sequelize-cli migration:generate --name",
    "seed:generate": "sequelize-cli seed:generate --name",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/frontend/",
      "/chatbot-ia/"
    ],
    "moduleNameMapper": {
      "^uuid$": "<rootDir>/src/tests/support/uuid.js"
    }
  },
  "keywords": [
    "ecommerce",
    "nodejs",
    "sequelize",
    "prisma",
    "postgresql"
  ],
  "author": "Ayoub Aguezar",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.6.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "groq-sdk": "^1.5.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0",
    "safer-buffer": "^2.1.2",
    "sequelize": "^6.37.8",
    "stripe": "^22.4.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "escalade": "^3.2.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prisma": "^7.8.0",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2"
  }
}
