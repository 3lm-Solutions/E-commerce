# Copier en .env.local puis redémarrer Vite après chaque changement.

# true : mode mock, MSW simule toute l'API (backend et chatbot) à partir de /fixtures
VITE_USE_MOCK=false

# URL du service chatbot (Flask, chatbot-ia/backend). Par défaut : http://localhost:5000
VITE_CHATBOT_URL=http://localhost:5000
