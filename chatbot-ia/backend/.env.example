# Fichier d'exemple des variables d'environnement du backend chatbot IA
# ---------------------------------------------------------------
# Copiez ce fichier vers .env et renseignez vos vraies valeurs.
#   cp .env.example .env          (Linux/macOS)
#   copy .env.example .env        (Windows)
#
# ⚠️  Ne JAMAIS commiter le fichier .env réel (il est déjà ignoré par
#     le .gitignore du dossier chatbot-ia).
#
# ⚠️  Ce fichier .env est INDISPENSABLE : sans lui, python-dotenv remonte
#     jusqu'au .env de la racine du projet (PORT=3000, celui du backend Node)
#     et Flask démarre sur le même port que le backend.

# Clé API Groq (obligatoire)
GROQ_API_KEY=your-api-key-here

# Modèle Groq (même variable que le backend Node). llama-3.3-70b-versatile
# n'existe plus chez Groq. Défaut si absent : qwen/qwen3.8-27b
GROQ_MODEL=qwen/qwen3.8-27b

# Port HTTP du serveur Flask (cohérent avec http://localhost:5000 du openapi.yaml)
PORT=5000

# Environnement Flask (development / production)
FLASK_ENV=development

# URL de base du backend Node.js (route interne /api/internal/chatbot-catalog)
# Utilisée par le backend Flask pour récupérer le catalogue produits.
NODE_BACKEND_URL=http://localhost:3000

